# ── SPA ROUTING ──────────────────────────────────────────────────────────────
# Rewrites all requests to index.html so React Router handles client-side paths.
# Without this, refreshing /blog or /contact returns a 404 from LiteSpeed.

Options -MultiViews
RewriteEngine On
RewriteBase /

# Pass through real files and directories unchanged
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-l
RewriteRule ^ index.html [QSA,L]

# ── BROWSER CACHING ───────────────────────────────────────────────────────────
# Aggressive caching for hashed Vite assets (they change hash on every rebuild).
# Logo and favicon get 1-year cache; index.html must never be cached.

<IfModule mod_expires.c>
  ExpiresActive On

  # Vite-built JS/CSS/images already have content-hash in filename — cache forever
  <FilesMatch "\.(js|css|woff2|woff|ttf)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images: 1 year
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # index.html: must not be cached so users always get the latest app shell
  <Files "index.html">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </Files>
</IfModule>

# ── GZIP COMPRESSION ──────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# ── SECURITY HEADERS ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
