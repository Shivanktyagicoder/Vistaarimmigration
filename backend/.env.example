# Server
PORT=5000

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<db_username>:<db_password>@website.iztkyzs.mongodb.net/

# Email SMTP Settings (e.g. Gmail SMTP, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here

# Email recipients
NOTIFY_EMAIL=info@vistaarimmigration.com

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# Admin API Key (For securing GET /api/contact)
# Generate a secure random string for this key (e.g. using a password generator or uuid)
ADMIN_API_KEY=your_secure_admin_api_key_here

